<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
    The Room database holds raw SMS bank-message bodies and account numbers. Exclude it from
    Android's cloud backup and device-to-device transfer so that data isn't copied to the
    user's Google account (or a new device) without an explicit, deliberate export action via
    the in-app JSON/CSV backup instead.
    -->
    <cloud-backup>
        <exclude domain="database" path="smart_budget_db" />
        <exclude domain="database" path="smart_budget_db-wal" />
        <exclude domain="database" path="smart_budget_db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="smart_budget_db" />
        <exclude domain="database" path="smart_budget_db-wal" />
        <exclude domain="database" path="smart_budget_db-shm" />
    </device-transfer>
</data-extraction-rules>
