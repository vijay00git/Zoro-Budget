<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
    Pre-API 31 full backup equivalent of data_extraction_rules.xml: keep the Room database
    (raw SMS bodies, account numbers) out of Android's automatic backup.
    -->
    <exclude domain="database" path="smart_budget_db" />
    <exclude domain="database" path="smart_budget_db-wal" />
    <exclude domain="database" path="smart_budget_db-shm" />
    <exclude domain="file" path="savings_attachments/" />
    <exclude domain="file" path="backups/" />
</full-backup-content>
